{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MobileSnapshotV1",
  "$defs": {
    "Label": {
      "type": "string",
      "maxLength": 2048
    },
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "format": "opaque-id"
    },
    "Decimal": {
      "type": "string",
      "format": "exact-decimal",
      "maxLength": 29
    },
    "Sequence": {
      "type": "string",
      "format": "sequence",
      "maxLength": 20
    },
    "Date": {
      "type": "string",
      "format": "date"
    },
    "Month": {
      "type": "string",
      "format": "month"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "utc-timestamp"
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "accounts",
        "investments",
        "budgets",
        "reports",
        "comparisons",
        "calculators"
      ],
      "properties": {
        "overview": {
          "$ref": "#/$defs/Availability"
        },
        "accounts": {
          "$ref": "#/$defs/Availability"
        },
        "investments": {
          "$ref": "#/$defs/Availability"
        },
        "budgets": {
          "$ref": "#/$defs/Availability"
        },
        "reports": {
          "$ref": "#/$defs/Availability"
        },
        "comparisons": {
          "$ref": "#/$defs/Availability"
        },
        "calculators": {
          "$ref": "#/$defs/Availability"
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "icon"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "name": {
          "$ref": "#/$defs/Label"
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "netWorth",
        "cash",
        "debtContribution",
        "investments",
        "otherAccounts",
        "propertyValue",
        "propertyValuedFrom",
        "propertyValuedThrough",
        "averageMonthlySpend",
        "runwayMonths"
      ],
      "properties": {
        "netWorth": {
          "$ref": "#/$defs/Decimal"
        },
        "cash": {
          "$ref": "#/$defs/Decimal"
        },
        "debtContribution": {
          "$ref": "#/$defs/Decimal"
        },
        "investments": {
          "$ref": "#/$defs/Decimal"
        },
        "otherAccounts": {
          "$ref": "#/$defs/Decimal"
        },
        "propertyValue": {
          "$ref": "#/$defs/Decimal"
        },
        "propertyValuedFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "propertyValuedThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "averageMonthlySpend": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "runwayMonths": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "accountType",
        "balance",
        "startingBalance",
        "netWorthContribution",
        "owed",
        "balanceBasis",
        "checkpointDate",
        "memberId",
        "icon"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "name": {
          "$ref": "#/$defs/Label"
        },
        "accountType": {
          "type": "string",
          "enum": [
            "checking",
            "savings",
            "credit",
            "loan",
            "investment",
            "other"
          ]
        },
        "balance": {
          "$ref": "#/$defs/Decimal"
        },
        "startingBalance": {
          "$ref": "#/$defs/Decimal"
        },
        "netWorthContribution": {
          "$ref": "#/$defs/Decimal"
        },
        "owed": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "balanceBasis": {
          "type": "string",
          "enum": [
            "ledger",
            "holdings"
          ]
        },
        "checkpointDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "memberId": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "name": {
          "$ref": "#/$defs/Label"
        }
      }
    },
    "QuoteCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "valuedPositions",
        "totalPositions",
        "quoteTimestamp",
        "previousCloseDate"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "valuedPositions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "totalPositions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "quoteTimestamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousCloseDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InvestmentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "value",
        "costBasis",
        "unrealizedGain",
        "dayChange",
        "coverage"
      ],
      "properties": {
        "accountId": {
          "$ref": "#/$defs/OpaqueId"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "costBasis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "unrealizedGain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "dayChange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/QuoteCoverage"
        }
      }
    },
    "Investments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "costBasis",
        "unrealizedGain",
        "dayChange",
        "coverage",
        "accounts"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "costBasis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "unrealizedGain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "dayChange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/QuoteCoverage"
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InvestmentSummary"
          }
        }
      }
    },
    "BudgetLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "group",
        "order",
        "planned",
        "actual",
        "rollover",
        "effectiveBudget",
        "remaining",
        "capEnabled",
        "rolloverEnabled",
        "alert"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/Label"
        },
        "group": {
          "type": "string",
          "enum": [
            "income",
            "fixed",
            "flexible",
            "nonmonthly"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "planned": {
          "$ref": "#/$defs/Decimal"
        },
        "actual": {
          "$ref": "#/$defs/Decimal"
        },
        "rollover": {
          "$ref": "#/$defs/Decimal"
        },
        "effectiveBudget": {
          "$ref": "#/$defs/Decimal"
        },
        "remaining": {
          "$ref": "#/$defs/Decimal"
        },
        "capEnabled": {
          "type": "boolean"
        },
        "rolloverEnabled": {
          "type": "boolean"
        },
        "alert": {
          "type": "string",
          "enum": [
            "none",
            "warning",
            "over"
          ]
        }
      }
    },
    "BudgetMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "actualThrough",
        "sourceMonth",
        "capFeatureEnabled",
        "rolloverFeatureEnabled",
        "lines",
        "unbudgetedSpending",
        "actualIncome",
        "actualSpending"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/Month"
        },
        "actualThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceMonth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Month"
            },
            {
              "type": "null"
            }
          ]
        },
        "capFeatureEnabled": {
          "type": "boolean"
        },
        "rolloverFeatureEnabled": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BudgetLine"
          }
        },
        "unbudgetedSpending": {
          "$ref": "#/$defs/Decimal"
        },
        "actualIncome": {
          "$ref": "#/$defs/Decimal"
        },
        "actualSpending": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "MonthTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "income",
        "spending",
        "savingsRatePct"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/Month"
        },
        "income": {
          "$ref": "#/$defs/Decimal"
        },
        "spending": {
          "$ref": "#/$defs/Decimal"
        },
        "savingsRatePct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CategoryMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "category",
        "group",
        "spending"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/Month"
        },
        "category": {
          "$ref": "#/$defs/Label"
        },
        "group": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "income",
                "fixed",
                "flexible",
                "nonmonthly"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "spending": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "BudgetCategoryMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "category",
        "signedAmount"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/Month"
        },
        "category": {
          "$ref": "#/$defs/Label"
        },
        "signedAmount": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "DailySpend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "spending"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "spending": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "MonthBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "id",
        "label",
        "income",
        "spending"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/Month"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "income": {
          "$ref": "#/$defs/Decimal"
        },
        "spending": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "NetWorthPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "netWorth",
        "cash",
        "debtContribution",
        "investments",
        "propertyValue",
        "valuationBasis"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "netWorth": {
          "$ref": "#/$defs/Decimal"
        },
        "cash": {
          "$ref": "#/$defs/Decimal"
        },
        "debtContribution": {
          "$ref": "#/$defs/Decimal"
        },
        "investments": {
          "$ref": "#/$defs/Decimal"
        },
        "propertyValue": {
          "$ref": "#/$defs/Decimal"
        },
        "valuationBasis": {
          "type": "string",
          "enum": [
            "current_saved_values",
            "recorded"
          ]
        }
      }
    },
    "ValuePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "value"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "MemberWorth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "label",
        "value"
      ],
      "properties": {
        "memberId": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        }
      }
    },
    "History": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromMonth",
        "throughMonth",
        "actualThrough",
        "months",
        "categories",
        "budgetCategoryNet",
        "daily",
        "accounts",
        "members",
        "tags",
        "merchants",
        "netWorth",
        "portfolio",
        "memberNetWorth"
      ],
      "properties": {
        "fromMonth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Month"
            },
            {
              "type": "null"
            }
          ]
        },
        "throughMonth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Month"
            },
            {
              "type": "null"
            }
          ]
        },
        "actualThrough": {
          "$ref": "#/$defs/Date"
        },
        "months": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonthTotals"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CategoryMonth"
          }
        },
        "budgetCategoryNet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BudgetCategoryMonth"
          }
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DailySpend"
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonthBreakdown"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonthBreakdown"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonthBreakdown"
          }
        },
        "merchants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonthBreakdown"
          }
        },
        "netWorth": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetWorthPoint"
          }
        },
        "portfolio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValuePoint"
          }
        },
        "memberNetWorth": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberWorth"
          }
        }
      }
    },
    "DollarBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "period"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "month",
            "annual_average"
          ]
        },
        "period": {
          "$ref": "#/$defs/Label"
        }
      }
    },
    "ComparisonReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "definitionId",
        "value",
        "adjustedValue",
        "uncertainty",
        "uncertaintyKind",
        "unit",
        "statistic",
        "population",
        "universe",
        "geography",
        "ageMin",
        "ageMax",
        "periodKind",
        "periodFrom",
        "periodTo",
        "dollarBasis",
        "adjustedBasisMonth",
        "cpiFactor",
        "sourceId",
        "sourceUrl",
        "sourceLocator",
        "annotation",
        "reliability"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Label"
        },
        "mode": {
          "type": "string",
          "enum": [
            "household",
            "individual"
          ]
        },
        "definitionId": {
          "$ref": "#/$defs/Label"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "adjustedValue": {
          "$ref": "#/$defs/Decimal"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertaintyKind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "moe90",
                "se"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "usd_per_year",
            "usd_per_month",
            "usd_balance"
          ]
        },
        "statistic": {
          "type": "string",
          "enum": [
            "mean",
            "median"
          ]
        },
        "population": {
          "$ref": "#/$defs/Label"
        },
        "universe": {
          "type": "string",
          "enum": [
            "all",
            "holders"
          ]
        },
        "geography": {
          "$ref": "#/$defs/Label"
        },
        "ageMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ageMax": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "periodKind": {
          "type": "string",
          "enum": [
            "flow",
            "stock"
          ]
        },
        "periodFrom": {
          "$ref": "#/$defs/Date"
        },
        "periodTo": {
          "$ref": "#/$defs/Date"
        },
        "dollarBasis": {
          "$ref": "#/$defs/DollarBasis"
        },
        "adjustedBasisMonth": {
          "$ref": "#/$defs/Month"
        },
        "cpiFactor": {
          "$ref": "#/$defs/Decimal"
        },
        "sourceId": {
          "$ref": "#/$defs/Label"
        },
        "sourceUrl": {
          "$ref": "#/$defs/Label"
        },
        "sourceLocator": {
          "$ref": "#/$defs/Label"
        },
        "annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "reliability": {
          "type": "string",
          "enum": [
            "ok",
            "unreliable"
          ]
        }
      }
    },
    "ComparisonReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail",
        "options"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Label"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
