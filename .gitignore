# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust build output (workspace-level — core + src-tauri share this one dir)
/target

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Real transaction data / database backups — this folder has held real
# bank exports before; ignore everything dropped in here by default and
# only allow back in the known-safe synthetic fixtures used for manual
# testing. A real export added later stays untracked automatically.
data/incoming/*
!data/incoming/.gitkeep
!data/incoming/sample.csv
!data/incoming/sample_month2.csv
!data/incoming/sample.ofx
!data/incoming/sample.qif
db-backups/

# Throwaway database used by `npm run tauri:dev:sandbox` — never the real
# AppData file, safe to test against freely.
.dev-sandbox/

# Rebuilt from scratch by `npm run demo` (e2e/demo.mjs) on every launch.
.demo-data/

# Code-signing material — never commit a private key/certificate
*.pfx
*.p12
*.pem
*.key

# Local planning/scratch notes from AI-assisted work sessions — useful on
# this machine, not something other clones of the repo need.
/Claude outputs/

# Per-machine E2E spec timing history (run-all.mjs's longest-first
# scheduling) — self-generated, machine-specific, and rebuilds itself.
/e2e/.e2e-durations.json
