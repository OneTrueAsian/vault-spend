{
  "name": "vault-spend",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.mobile.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run-all.mjs",
    "e2e:smoke": "node e2e/run-all.mjs --spec=smoke",
    "demo": "node e2e/demo.mjs",
    "demo:household": "node e2e/household-demo.mjs",
    "tauri": "tauri",
    "tauri:dev:sandbox": "cross-env VAULTSPEND_DB_DIR=$INIT_CWD/.dev-sandbox tauri dev",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "tsc && vite build --config vite.mobile.config.ts",
    "mobile:build:preview": "tsc && vite build --config vite.mobile.config.ts --mode preview",
    "mobile:preview": "vite preview --config vite.mobile.config.ts --mode preview",
    "mobile:e2e": "npm run mobile:build && npm run mobile:build:preview && node tools/test_mobile_viewer.mjs",
    "mobile:build:offline-test": "tsc && vite build --config vite.mobile.config.ts --mode offline-test",
    "mobile:offline:e2e": "npm run mobile:build:offline-test && node tools/test_mobile_offline.mjs",
    "mobile:acceptance:e2e": "npm run mobile:build:offline-test && node tools/test_mobile_cross_browser.mjs",
    "mobile:tls:e2e": "node tools/test_mobile_trusted_firefox.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "chrono-node": "^2.10.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.42.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.63.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "webdriverio": "^9.31.5"
  }
}
